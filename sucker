#!/usr/bin/env python3
"""Run individually approved Docker commands; authenticate once in tmux."""

import argparse
import array
import fcntl
import grp
import html
import json
import os
from pathlib import Path
import pwd
import queue
import re
import select
import shlex
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time


DOCKER = "/usr/bin/docker"
BROKER = "/usr/local/libexec/sucker-broker"
ASKPASS = "/usr/local/libexec/sucker-askpass"
BROKER_USER = "sucker"
GUI_KEYS = ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
            "XAUTHORITY", "LANG")
MAX_REQUEST = 65536


def identity(pid):
    path = Path(f"/proc/{pid}/stat")
    text = path.read_text()
    fields = text.rsplit(")", 1)[1].split()
    if fields[0] == "Z":
        raise ProcessLookupError("Process has exited")
    return {"pid": int(pid), "start": fields[19], "uid": path.stat().st_uid}


def alive(target):
    try:
        return identity(target["pid"]) == target
    except (OSError, ValueError):
        return False


def state_paths():
    base = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"sucker-user-{os.getuid()}"
    base.mkdir(mode=0o700, exist_ok=True)
    info = base.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError(f"Unsafe state directory: {base}")
    stem = base / "session"
    return {kind: Path(str(stem) + "." + kind) for kind in ("json", "lock", "error", "stop")}


def active_endpoint(paths):
    try:
        state = json.loads(paths["json"].read_text())
        if state["uid"] == os.getuid() and alive(state["host"]):
            endpoint = state["endpoint"]
            if Path(endpoint).is_socket():
                return endpoint
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def ensure_broker():
    paths = state_paths()
    with paths["lock"].open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        endpoint = active_endpoint(paths)
        if endpoint:
            if paths["stop"].exists():
                raise ValueError("Broker is stopping; retry shortly.")
            return endpoint
        if not Path(BROKER).is_file():
            raise ValueError("Broker is not installed. Run sudo ./sucker broker setup from the repository.")
        if not Path(ASKPASS).is_file():
            raise ValueError("Docker PIN helper is not installed. Re-run sudo ./sucker broker setup.")
        if not shutil.which("tmux"):
            raise ValueError("tmux is required. Install it before running sucker.")
        if not Path("/usr/bin/zenity").is_file():
            raise ValueError("zenity is required for command approval dialogs.")
        if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            raise ValueError("A graphical session is required for approval dialogs.")
        paths["error"].unlink(missing_ok=True)
        paths["stop"].unlink(missing_ok=True)
        name = f"sucker-{os.getuid()}"
        gui = {key: os.environ[key] for key in GUI_KEYS if key in os.environ}
        command = [sys.executable, "-I", str(Path(__file__).resolve()), "__host",
                   json.dumps(gui)]
        exists = subprocess.run(["tmux", "has-session", "-t", "=" + name],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if not exists:
            subprocess.run(["tmux", "new-session", "-d", "-s", name,
                            "exec " + shlex.join(command)], check=True)
        print("sucker: unlock Docker in the Docker PIN dialog.", file=sys.stderr)
        deadline = time.monotonic() + 120
        while time.monotonic() < deadline:
            if paths["stop"].exists():
                raise ValueError("Broker startup cancelled.")
            endpoint = active_endpoint(paths)
            if endpoint:
                return endpoint
            if paths["error"].exists():
                raise ValueError(paths["error"].read_text())
            time.sleep(0.1)
        raise ValueError("Still waiting for the Docker PIN dialog. Complete it, then retry.")


def stop_broker():
    paths = state_paths()
    name = f"=sucker-{os.getuid()}"

    def running():
        return subprocess.run(["tmux", "has-session", "-t", name],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0

    if not shutil.which("tmux") or not running():
        paths["json"].unlink(missing_ok=True)
        return
    # The host cooperatively closes its dialogs and the broker's liveness pipe.
    paths["stop"].touch(mode=0o600)
    deadline = time.monotonic() + 15
    while running():
        if time.monotonic() >= deadline:
            subprocess.run(["tmux", "kill-session", "-t", name], check=True)
            break
        time.sleep(0.1)
    paths["json"].unlink(missing_ok=True)


def host(gui):
    # An existing tmux server may have an older desktop environment. Keep GUI
    # and state-directory discovery consistent with the invoking client.
    for key in GUI_KEYS:
        os.environ.pop(key, None)
    os.environ.update({key: value for key, value in gui.items() if key in GUI_KEYS})
    paths = state_paths()
    process = None
    temporary_name = None
    approval_events = {}
    approval_workers = []
    write_lock = threading.Lock()
    messages = queue.Queue()
    reader = None
    shutdown = threading.Event()
    if threading.current_thread() is threading.main_thread():
        for name in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
            signal.signal(name, lambda *_: shutdown.set())
    try:
        print("Docker PIN authentication through zenity; tmux remains detached.", flush=True)
        environment = dict(os.environ, SUDO_ASKPASS=ASKPASS)
        process = subprocess.Popen(
            ["sudo", "-A", "-k", "-u", BROKER_USER, "--", "/usr/bin/python3", "-I", BROKER,
             "__broker"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=environment,
        )

        def read_messages():
            try:
                for line in process.stdout:
                    messages.put(line)
            finally:
                messages.put(None)

        reader = threading.Thread(target=read_messages, daemon=True)
        reader.start()
        ready = False
        while True:
            if shutdown.is_set() or paths["stop"].exists():
                break
            try:
                line = messages.get(timeout=0.2)
            except queue.Empty:
                continue
            if not line:
                break
            message = json.loads(line)
            if message["type"] == "ready":
                endpoint = message["endpoint"]
                if not Path(endpoint).is_socket():
                    raise ValueError("Invalid broker endpoint.")
                state = {"uid": os.getuid(), "host": identity(os.getpid()), "endpoint": endpoint}
                descriptor, temporary_name = tempfile.mkstemp(dir=paths["json"].parent)
                with os.fdopen(descriptor, "w") as stream:
                    json.dump(state, stream)
                os.replace(temporary_name, paths["json"])
                ready = True
                print("Ready. Docker commands require approval in separate dialogs.", flush=True)
            elif message["type"] == "approve":
                event = threading.Event()
                approval_events[message["id"]] = event

                def show_dialog(request=message, cancellation=event):
                    def cancelled():
                        return (cancellation.is_set() or shutdown.is_set() or
                                paths["stop"].exists() or process.poll() is not None)
                    try:
                        allowed = approve(request["args"], request["cwd"], gui, cancelled)
                        with write_lock:
                            process.stdin.write(json.dumps({"id": request["id"], "allow": allowed}) + "\n")
                            process.stdin.flush()
                    except (OSError, ValueError):
                        # A failed or closed dialog can never grant permission.
                        try:
                            with write_lock:
                                process.stdin.write(json.dumps({"id": request["id"], "allow": False}) + "\n")
                                process.stdin.flush()
                        except (OSError, ValueError):
                            pass

                worker = threading.Thread(target=show_dialog, daemon=True)
                approval_workers = [old for old in approval_workers if old.is_alive()]
                approval_workers.append(worker)
                worker.start()
            elif message["type"] == "cancel":
                event = approval_events.pop(message["id"], None)
                if event:
                    event.set()
            else:
                raise ValueError("Unexpected broker message.")
        if not ready:
            if shutdown.is_set() or paths["stop"].exists():
                raise ValueError("Broker startup cancelled.")
            raise ValueError("Sudo authentication or broker startup failed.")
    except (OSError, ValueError, KeyboardInterrupt) as error:
        paths["error"].write_text(str(error) or "Authentication cancelled.")
        raise
    finally:
        paths["json"].unlink(missing_ok=True)
        if temporary_name:
            Path(temporary_name).unlink(missing_ok=True)
        if process:
            for event in approval_events.values():
                event.set()
            for worker in approval_workers:
                worker.join(timeout=3)
            try:
                process.stdin.close()
            except BrokenPipeError:
                pass
            if process.poll() is None:
                try:
                    process.wait(timeout=8)
                except subprocess.TimeoutExpired:
                    # sudo may still be waiting for authentication in the pane.
                    process.terminate()
                    process.wait()
            if reader:
                reader.join(timeout=2)
            process.stdout.close()


def disconnected(connection):
    if select.select([connection], [], [], 0)[0]:
        return not connection.recv(1, socket.MSG_PEEK)
    return False


def stop_child(process):
    if process.poll() is None:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()


def format_command(arguments, limit=72, head=32, tail=24):
    """Create compact display text; keep execution arguments untouched."""
    parts = ["sucker"]
    markers = []
    for index, argument in enumerate(arguments):
        if len(argument) > limit:
            marker = f"SUCKERTRUNCATIONTOKEN{index}X"
            while any(marker in item for item in arguments):
                marker += "X"
            argument = argument[:head] + marker + argument[-tail:]
            markers.append(marker)
        parts.append(shlex.quote(argument))
    display = json.dumps(" ".join(parts), ensure_ascii=False)[1:-1]
    return display, markers


def approve(arguments, cwd, gui, cancelled):
    environment = dict(os.environ)
    environment.update({key: value for key, value in gui.items() if key in GUI_KEYS})
    # Argument text is data, with control characters escaped and markup disabled.
    display, truncation_markers = format_command(arguments)
    home = str(Path.home())
    directory = "~" + cwd[len(home):] if cwd == home or cwd.startswith(home + "/") else cwd
    directory = json.dumps(directory, ensure_ascii=False)[1:-1]
    spacer = "\N{NO-BREAK SPACE}" * 160
    command_markup = html.escape(display, quote=True)
    for marker in truncation_markers:
        command_markup = command_markup.replace(marker, "<i> [...] </i>", 1)
    directory_markup = html.escape(directory, quote=True)
    text = (f"{spacer}\n<span size=\"large\"><tt>{command_markup}</tt>\n"
            f"({directory_markup})</span>\n{spacer}")
    with subprocess.Popen(["/usr/bin/zenity", "--question", "--no-wrap",
                           "--icon=utilities-terminal", "--default-cancel",
                           "--title=Command approval", "--ok-label=Allow", "--cancel-label=Deny",
                           "--text=" + text], env=environment, stdin=subprocess.DEVNULL,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                          start_new_session=True) as dialog:
        try:
            while dialog.poll() is None:
                if cancelled():
                    stop_child(dialog)
                    return False
                time.sleep(0.1)
            return dialog.returncode == 0
        finally:
            stop_child(dialog)


def receive_request(connection):
    descriptors = array.array("i")
    try:
        data, ancillary, flags, _ = connection.recvmsg(MAX_REQUEST, socket.CMSG_SPACE(3 * descriptors.itemsize))
        for level, kind, payload in ancillary:
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                descriptors.frombytes(payload[:len(payload) - len(payload) % descriptors.itemsize])
        if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) or len(descriptors) != 3:
            raise ValueError("Expected one request and three stdio descriptors.")
        request = json.loads(data)
        args, cwd = request["args"], request["cwd"]
        if (not isinstance(args, list) or not args or
                not all(isinstance(arg, str) and "\0" not in arg for arg in args) or
                not isinstance(cwd, str) or not os.path.isabs(cwd) or "\0" in cwd):
            raise ValueError("Invalid Docker arguments or working directory.")
        return args, cwd, descriptors.tolist()
    except BaseException:
        for descriptor in descriptors:
            os.close(descriptor)
        raise


def handle(connection, uid, stop, confirm, executable):
    descriptors = []
    process = None
    with connection:
        try:
            _, peer_uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if peer_uid != uid:
                raise ValueError("Request is from a different user.")
            connection.settimeout(5)
            arguments, cwd, descriptors = receive_request(connection)
            connection.settimeout(None)

            def cancelled():
                return stop.is_set() or disconnected(connection)

            if cancelled() or not confirm(arguments, cwd, cancelled):
                connection.send(json.dumps({"status": 126, "error": "Command denied."}).encode())
                return
            if cancelled():
                return
            # The broker executes precisely what was displayed, with no shell.
            # The peer supplies only argv/cwd and already-open stdio, never env
            # overrides or the path of the privileged executable.
            process = subprocess.Popen([executable, *arguments], cwd=cwd,
                                       stdin=descriptors[0], stdout=descriptors[1], stderr=descriptors[2],
                                       env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                                            "HOME": pwd.getpwuid(os.geteuid()).pw_dir},
                                       start_new_session=True)
            for descriptor in descriptors:
                os.close(descriptor)
            descriptors = []
            while process.poll() is None:
                if cancelled():
                    stop_child(process)
                    return
                if select.select([connection], [], [], 0.1)[0]:
                    message = connection.recv(32)
                    if message == b"INT":
                        os.killpg(process.pid, signal.SIGINT)
                    elif message:
                        raise ValueError("Unexpected control message.")
            status = process.returncode
            connection.send(json.dumps({"status": status if status >= 0 else 128 - status}).encode())
        except (OSError, ValueError, KeyError, TypeError) as error:
            try:
                connection.send(json.dumps({"status": 1, "error": str(error)}).encode())
            except OSError:
                pass
        finally:
            if process:
                stop_child(process)
            for descriptor in descriptors:
                os.close(descriptor)


def broker(uid, confirm=None, executable=DOCKER):
    stop = threading.Event()
    for name in (signal.SIGINT, signal.SIGQUIT, signal.SIGHUP):
        signal.signal(name, lambda *_: stop.set())
    approval_condition = threading.Condition()
    replies = {}
    pending = set()
    directory = Path(tempfile.mkdtemp(prefix="sucker-broker-", dir="/tmp"))
    endpoint = directory / "commands.sock"
    workers = []

    def ask_host(arguments, cwd, cancelled):
        # The host is an unprivileged process in the initiating user's desktop.
        # It owns the GUI; the dedicated Docker user never opens display windows.
        token = os.urandom(16).hex()
        with approval_condition:
            pending.add(token)
            print(json.dumps({"type": "approve", "id": token, "args": arguments, "cwd": cwd}), flush=True)
            try:
                while token not in replies and not cancelled():
                    approval_condition.wait(timeout=0.2)
                return replies.pop(token, False) is True and not cancelled()
            finally:
                pending.discard(token)
                replies.pop(token, None)
                print(json.dumps({"type": "cancel", "id": token}), flush=True)

    def watch_host():
        try:
            for line in sys.stdin:
                reply = json.loads(line)
                with approval_condition:
                    if reply.get("id") in pending:
                        replies[reply["id"]] = reply.get("allow") is True
                        approval_condition.notify_all()
        except (OSError, ValueError, TypeError):
            pass
        finally:
            stop.set()

    try:
        directory.chmod(0o711)
        with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as listener:
            listener.bind(str(endpoint))
            if os.geteuid() == 0:
                endpoint.chmod(0o600)
                os.chown(endpoint, uid, -1)
            else:
                # A dedicated non-root broker cannot chown the socket. Peer
                # credentials are checked before parsing.
                endpoint.chmod(0o666)
            listener.listen(32)
            listener.settimeout(0.2)
            threading.Thread(target=watch_host, daemon=True).start()
            print(json.dumps({"type": "ready", "endpoint": str(endpoint)}), flush=True)
            while not stop.is_set():
                try:
                    client, _ = listener.accept()
                except socket.timeout:
                    continue
                worker = threading.Thread(target=handle,
                                          args=(client, uid, stop, confirm or ask_host, executable), daemon=True)
                workers = [old for old in workers if old.is_alive()]
                workers.append(worker)
                worker.start()
    finally:
        stop.set()
        for worker in workers:
            worker.join(timeout=6)
        endpoint.unlink(missing_ok=True)
        directory.rmdir()


def request(endpoint, arguments, cwd=None, descriptors=None):
    data = json.dumps({"args": arguments, "cwd": cwd or os.getcwd()}).encode()
    if len(data) > MAX_REQUEST:
        raise ValueError("Command is too long.")
    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as connection:
        connection.connect(endpoint)
        fds = array.array("i", descriptors if descriptors is not None else [0, 1, 2])
        connection.sendmsg([data], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, fds)])
        while True:
            try:
                result = connection.recv(MAX_REQUEST)
                if not result:
                    raise ValueError("Broker closed the connection; the command was not retried.")
                reply = json.loads(result)
                if reply.get("error"):
                    print("sucker: " + reply["error"], file=sys.stderr)
                return reply["status"]
            except KeyboardInterrupt:
                # Close this request; the broker cancels its dialog/child.
                raise


def askpass():
    # Never capture, print, persist, or put the secret in process arguments.
    # sudo runs this helper as the desktop user and reads stdout privately.
    os.execv("/usr/bin/zenity", ["zenity", "--entry", "--hide-text",
                               "--title=Docker PIN", "--text=",
                               "--ok-label=Unlock", "--cancel-label=Cancel"])


def sudo_rule(user):
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*\$?", user):
        raise ValueError("Unsupported login name.")
    alias = "SUCKER_BROKER_" + user.encode().hex().upper()
    return (f"# Installed by sucker broker setup; authentication is required.\n"
            f"Cmnd_Alias {alias} = /usr/bin/python3 -I {BROKER} __broker\n"
            f"Defaults!{alias} targetpw\n"
            f"{user} ALL=(sucker) PASSWD: {alias}\n")


def configure_pin(force=False):
    status = subprocess.run(["passwd", "-S", BROKER_USER], check=True,
                            capture_output=True, text=True)
    change = force or status.stdout.split()[1] != "P"
    if not change:
        try:
            change = input("Change Docker PIN? [y/N] ").strip().lower() in {"y", "yes"}
        except EOFError:
            change = False
    if change:
        print("Set the Docker PIN (password for account sucker):", flush=True)
        subprocess.run(["passwd", BROKER_USER], check=True)


def install_main(arguments):
    parser = argparse.ArgumentParser(
        prog="sucker broker setup",
        description="Install the dedicated sucker account, broker and password-protected sudo rule.")
    parser.add_argument("--user", default=os.environ.get("SUDO_USER"),
                        help="desktop user allowed to start the broker (default: SUDO_USER)")
    parser.add_argument("--set-pin", action="store_true",
                        help="set/reset the Docker PIN (password of account sucker)")
    args = parser.parse_args(arguments)
    if os.geteuid() != 0:
        parser.error("run with sudo: sudo ./sucker broker setup")
    if not args.user or args.user in {"root", BROKER_USER}:
        parser.error("specify the ordinary desktop user with --user")

    policy = sudo_rule(args.user)
    pwd.getpwnam(args.user)
    docker_group = grp.getgrnam("docker")
    for program in ("useradd", "usermod", "visudo", "passwd", "tmux", "zenity", "docker"):
        if not shutil.which(program):
            parser.error(f"missing dependency: {program}")

    source = Path(__file__).resolve()
    if not source.is_file():
        parser.error("cannot find the sucker script to install")
    try:
        account = pwd.getpwnam(BROKER_USER)
        if account.pw_dir != "/var/lib/sucker" or not account.pw_shell.endswith("/nologin"):
            parser.error("existing account sucker does not match the dedicated service account")
    except KeyError:
        subprocess.run(["useradd", "--system", "--user-group", "--create-home",
                        "--home-dir", "/var/lib/sucker", "--shell", "/usr/sbin/nologin",
                        "--groups", "docker", BROKER_USER], check=True)
    account = pwd.getpwnam(BROKER_USER)
    if docker_group.gr_gid not in os.getgrouplist(BROKER_USER, account.pw_gid):
        subprocess.run(["usermod", "--append", "--groups", "docker", BROKER_USER], check=True)
    configure_pin(args.set_pin)

    broker_path = Path(BROKER)
    askpass_path = Path(ASKPASS)
    broker_path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".sucker-", dir=broker_path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(source.read_bytes())
        os.chmod(temporary, 0o755)
        os.replace(temporary, broker_path)
    finally:
        Path(temporary).unlink(missing_ok=True)

    descriptor, temporary = tempfile.mkstemp(prefix=".sucker-askpass-", dir=askpass_path.parent)
    os.close(descriptor)
    os.unlink(temporary)
    try:
        os.symlink(broker_path, temporary)
        os.replace(temporary, askpass_path)
    finally:
        Path(temporary).unlink(missing_ok=True)

    directory = Path("/etc/sudoers.d")
    descriptor, temporary = tempfile.mkstemp(prefix=".sucker-", dir=directory)
    try:
        with os.fdopen(descriptor, "w") as stream:
            stream.write(policy)
        os.chmod(temporary, 0o440)
        subprocess.run(["visudo", "-c", "-f", temporary], check=True)
        os.replace(temporary, directory / f"sucker-{args.user}")
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(f"Installed broker as user sucker; {args.user} unlocks it with the Docker PIN in zenity.")
    print("Copy sucker to ~/.local/bin/sucker as your ordinary user. Re-run setup after broker updates.")


def setup_broker(arguments):
    # Setup changes system accounts and sudoers, so use normal admin sudo,
    # not the Docker PIN or the broker's restricted sudo permission.
    if os.geteuid() == 0 or "--help" in arguments or "-h" in arguments:
        return install_main(arguments)
    command = ["sudo", "--", "/usr/bin/python3", "-I",
               str(Path(__file__).resolve()), "__setup", *arguments]
    status = subprocess.run(command).returncode
    return status if status >= 0 else 128 - status


def main():
    arguments = sys.argv[1:]
    try:
        if Path(sys.argv[0]).name == Path(ASKPASS).name:
            askpass()
            return 0
        if arguments[:1] == ["__setup"]:
            return install_main(arguments[1:])
        if arguments[:1] == ["__broker"]:
            if (len(arguments) != 1 or "SUDO_UID" not in os.environ or
                    os.geteuid() != pwd.getpwnam(BROKER_USER).pw_uid):
                raise ValueError("The broker must be started through sudo as user sucker.")
            broker(int(os.environ["SUDO_UID"]))
            return 0
        if arguments[:1] == ["__host"]:
            if len(arguments) != 2:
                raise ValueError("Invalid host arguments.")
            host(json.loads(arguments[1]))
            return 0
        if arguments == ["askpass"]:
            askpass()
            return 0
        if not arguments or arguments == ["--help"]:
            print("Usage: sucker DOCKER_ARGS ...\n"
                  "       sucker askpass\n"
                  "       sucker broker {start|stop|restart|setup}\n"
                  "First command opens Docker PIN; every command needs separate GUI approval.")
            return 0
        if arguments[:1] == ["broker"]:
            if arguments[1:2] == ["setup"]:
                return setup_broker(arguments[2:])
            if len(arguments) != 2 or arguments[1] not in {"start", "stop", "restart"}:
                raise ValueError("Usage: sucker broker {start|stop|restart|setup}")
            action = arguments[1]
            if action in {"stop", "restart"}:
                stop_broker()
            if action in {"start", "restart"}:
                ensure_broker()
            print("sucker: broker stopped." if action == "stop" else "sucker: broker ready.")
            return 0
        if arguments[:1] == ["session"]:
            raise ValueError("No wrapper/start is needed. Run sucker with Docker arguments, e.g. sucker ps.")
        return request(ensure_broker(), arguments)
    except KeyboardInterrupt:
        return 130
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"sucker: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
